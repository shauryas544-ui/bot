# ==========================================
# Security & Secrets (Never commit tokens!)
# ==========================================
.env
.env.*
config.json
token.txt
secrets.py

# ==========================================
# Project-Specific Temporary & Output Files
# ==========================================
temp_*
translated_*
part_*
*.epub
*.docx
*.pdf

# Exception: Keep requirements or documentation text files
!requirements.txt
!README.md

# ==========================================
# Python & Bytecode Cache
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

