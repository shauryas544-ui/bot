# Virtual Environments
# ==========================================
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ==========================================
# IDE & Code Editors (PyCharm / VS Code)
# ==========================================
.idea/
.vscode/
*.swp
*.swo
*~

